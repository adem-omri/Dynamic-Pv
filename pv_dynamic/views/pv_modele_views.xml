<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORM VIEW: PV Modele -->
    <record id="view_pv_modele_form" model="ir.ui.view">
        <field name="name">pv.modele.form</field>
        <field name="model">pv.modele</field>
        <field name="arch" type="xml">
            <form string="PV Template">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Template Name..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <notebook>
                        <page string="Fields Definition" name="fields_def">
                            <field name="champ_ids">
                                <tree>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="type_champ"/>
                                    <field name="required"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="modele_id" invisible="1"/>
                                            <field name="name"/>
                                            <field name="type_champ"/>
                                            <field name="required"/>
                                            <field name="sequence"/>
                                        </group>
                                        <group string="Conditional Visibility">
                                            <field name="condition_field_id" options="{'no_create': True}"/>
                                            <field name="condition_operator" attrs="{'invisible': [('condition_field_id', '=', False)], 'required': [('condition_field_id', '!=', False)]}"/>
                                            <field name="condition_value" attrs="{'invisible': [('condition_field_id', '=', False)], 'required': [('condition_field_id', '!=', False)]}"/>
                                        </group>
                                    </group>
                                    <notebook attrs="{'invisible': [('type_champ', '!=', 'complex')]}">
                                        <page string="Subfields">
                                            <field name="subfield_ids">
                                                <tree editable="bottom">
                                                    <field name="sequence" widget="handle"/>
                                                    <field name="name"/>
                                                    <field name="type_champ"/>
                                                    <field name="required"/>
                                                </tree>
                                            </field>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- TREE VIEW: PV Modele -->
    <record id="view_pv_modele_tree" model="ir.ui.view">
        <field name="name">pv.modele.tree</field>
        <field name="model">pv.modele</field>
        <field name="arch" type="xml">
            <tree string="PV Templates">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- ACTION: PV Modele -->
    <record id="action_pv_modele" model="ir.actions.act_window">
        <field name="name">PV Templates</field>
        <field name="res_model">pv.modele</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENUS -->
    <menuitem id="menu_pv_root" name="PV Dynamic" sequence="10"/>
    <menuitem id="menu_pv_config" name="Configuration" parent="menu_pv_root" sequence="100"/>
    <menuitem id="menu_pv_modele" name="PV Templates" parent="menu_pv_config" action="action_pv_modele" sequence="10"/>

</odoo>
